# Vault configuration for Tataredu
# Copy this file to .env and fill in the values

# Vault server address
VAULT_ADDR=http://vault.vault:8200

# AppRole authentication
VAULT_ROLE_ID=your-role-id-here
VAULT_SECRET_ID=your-secret-id-here

# Alternative: Root token (only for development!)
# VAULT_TOKEN=your-root-token-here

# Vault namespace in Kubernetes
VAULT_NAMESPACE=vault

# Path prefix for secrets
VAULT_SECRET_PATH=secret/data/tataredu
