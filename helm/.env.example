# =============================================================================
# helm/.env.example — пример env-файла для деплоя через vals + vault
# Скопируйте в .env и замените значения на реальные vault-референсы
# или задайте переменные окружения для vault-подключения.
# =============================================================================

# Адрес Vault
VAULT_ADDR=http://127.0.0.1:8200

# AppRole credentials создаёт vault-setup.sh. Root token нужен только самому setup-скрипту.
VAULT_AUTH_METHOD=approle
VAULT_ROLE_ID=replace-with-role-id
VAULT_SECRET_ID=replace-with-secret-id

# Пропуск проверки TLS (для самоподписанных сертификатов)
VAULT_SKIP_VERIFY=false

# Неймспейс для деплоя
NAMESPACE=tataredu

# Имя helm-релиза
RELEASE_NAME=tataredu

VAULT_NAMESPACE=tataredu
VAULT_SERVICE=vault
