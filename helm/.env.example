# =============================================================================
# helm/.env.example — пример env-файла для деплоя через vals + vault
# Скопируйте в .env и замените значения на реальные vault-референсы
# или задайте переменные окружения для vault-подключения.
# =============================================================================

# Адрес Vault
VAULT_ADDR=http://127.0.0.1:8200

# Способ аутентификации (выберите один):
# Вариант 1 — Root token (только для dev)
VAULT_TOKEN=root

# Вариант 2 — AppRole (для CI/CD и продакшена)
# VAULT_ROLE_ID=<role_id из vault read auth/approle/role/tataredu-role/role-id>
# VAULT_SECRET_ID=<secret_id из vault write -f auth/approle/role/tataredu-role/secret-id>

# Пропуск проверки TLS (для самоподписанных сертификатов)
VAULT_SKIP_VERIFY=true

# Неймспейс для деплоя
NAMESPACE=tataredu

# Имя helm-релиза
RELEASE_NAME=tataredu
